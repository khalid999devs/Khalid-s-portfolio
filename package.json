{
  "name": "my-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Portfolio frontend and API workspace",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "install:all": "npm ci --prefix server && npm ci --prefix client",
    "test": "npm test --prefix server",
    "lint": "npm run lint --prefix client",
    "build": "npm run build --prefix client",
    "check": "npm test --prefix server && npm run lint --prefix client && npm run build --prefix client",
    "audit:server": "npm audit --prefix server",
    "audit:client": "npm audit --prefix client"
  }
}
