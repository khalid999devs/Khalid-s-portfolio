# Copy to `.env` and fill in. Never commit `.env`.
#
# Everything here is either a secret or genuinely different between a laptop and
# production. Nothing else belongs in this file.
#
# This used to hold 37 keys. Nineteen were read by no code at all, and most of
# the rest were tuning knobs nobody had ever changed: rate limit windows, bcrypt
# cost, body size limits, pool sizing, HTTP timeouts. Those are constants in the
# code now, where they can be seen and reviewed, rather than values that have to
# be right on every machine and fail quietly when they are not.
#
# The server validates this at startup and refuses to boot if something required
# is missing, so a misconfigured deploy fails loudly instead of running with a
# weak default.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=8000

# Comma separated, exact origins. No wildcards, no trailing slash. The API
# refuses any browser write from an origin that is not listed here.
REMOTE_CLIENT_APP=http://localhost:5173

# ---------------------------------------------------------------------------
# Secrets
#
# Generate each one separately:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Both must be at least 32 characters and must differ from each other; in
# production the server refuses to start otherwise. COOKIE_SECRET was once the
# literal string 'secret', committed to index.js. Rotating it signs every
# administrator out, which is the intended way to end sessions you no longer
# trust.
# ---------------------------------------------------------------------------

ADMIN_SECRET=
COOKIE_SECRET=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

DB_HOST=127.0.0.1
# 3306 is the MySQL default. MAMP and similar use 8889.
DB_PORT=3306
DB_NAME=khalid_portfolio
DB_USER=root
DB_PASS=

# TLS is mandatory in production and certificate verification cannot be turned
# off. Set DB_SSL_CA only if your provider requires a specific CA.
DB_SSL=false
DB_SSL_CA=

# ---------------------------------------------------------------------------
# Uploads
#
# Point this at a mounted volume in production. The default keeps uploads inside
# the application directory, where the next deploy deletes every one of them.
# ---------------------------------------------------------------------------

UPLOADS_DIR=

# ---------------------------------------------------------------------------
# Reverse proxy
#
# The number of proxies in front of this app. Too low and every visitor shares
# the proxy's address, so rate limits bucket everyone together. Too high and a
# client can forge X-Forwarded-For and appear as any address it likes. Direct
# exposure with no proxy is 0.
# ---------------------------------------------------------------------------

TRUST_PROXY_HOPS=0

# ---------------------------------------------------------------------------
# Email, for contact replies and the admin Mail & SMS page
#
# Implicit TLS on 465, certificate verification always on. Leave blank to
# disable sending: the panel reports the failure rather than pretending a
# message went out, and every attempt is recorded in the delivery log.
# ---------------------------------------------------------------------------

MAIL_HOST=
MAIL_PORT=465
SERVER_EMAIL=
MAIL_PASS=

# ---------------------------------------------------------------------------
# SMS gateway
#
# This provider authenticates with credentials in the query string, which
# proxies log, and its documented endpoint is plain HTTP. Point SMS_API_BASE at
# an HTTPS endpoint as soon as they offer one.
# ---------------------------------------------------------------------------

SMS_USERNAME=
SMS_PASS=
SMS_API_BASE=http://66.45.237.70
