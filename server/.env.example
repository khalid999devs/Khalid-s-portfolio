# Copy to `.env` and fill in. Never commit `.env`.
#
# The server validates this file at startup and refuses to boot if a required
# variable is missing, so a misconfigured deploy fails loudly instead of running
# with a weak default.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Signs administrator JWTs.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SECRET=

# Signs session cookies. Must differ from ADMIN_SECRET so compromising one does
# not compromise the other. This was previously the literal string 'secret',
# hardcoded in index.js -- rotate it, and expect existing sessions to end.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
COOKIE_SECRET=

# Comma-separated list of exact browser origins allowed to call this API.
# Example: https://khalidahammed.com,https://www.khalidahammed.com
REMOTE_CLIENT_APP=http://localhost:5173

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=8000

# Administrator session length in minutes (5-1440). The cookie lifetime tracks
# this exactly; the two used to disagree by 23 hours.
ADMIN_SESSION_MINUTES=60

# Cookie SameSite policy: lax | strict | none.
# 'lax' is correct while the site and API share a registrable domain
# (khalidahammed.com and api.khalidahammed.com are same-site). Hosting the
# client on an unrelated domain makes requests genuinely cross-site and
# requires 'none', which only works over HTTPS.
COOKIE_SAME_SITE=lax

# bcrypt cost for new administrator passwords (10-15).
SALT=12

# Reverse-proxy hops to trust for the client address (0-10). Must match the
# deployment exactly: too low and every visitor shares the proxy's address so
# rate limits bucket them together; too high and a client can forge
# X-Forwarded-For to appear as any address it likes.
TRUST_PROXY_HOPS=0

JSON_BODY_LIMIT=256kb
URL_ENCODED_BODY_LIMIT=64kb

API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX_REQUESTS=600
ADMIN_LOGIN_RATE_LIMIT_WINDOW_MS=900000
ADMIN_LOGIN_RATE_LIMIT_MAX_REQUESTS=10

# Where uploaded media lives. Point this at a mounted volume in production --
# the default sits inside the application directory, where any deploy that
# replaces that directory destroys every uploaded file.
UPLOADS_DIR=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

DB_HOST=localhost
DB_PORT=3306
DB_NAME=khalid_portfolio
DB_USER=
DB_PASS=

# Connection pool. MySQL defaults to 151 connections; a pool larger than the
# server allows turns a traffic spike into connection errors. This was 2000.
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_ACQUIRE_MS=30000
DB_POOL_IDLE_MS=10000

# TLS is mandatory in production and the server refuses to start without it.
# DB_SSL=false is honoured only outside production.
DB_SSL=false
DB_SSL_CA=
