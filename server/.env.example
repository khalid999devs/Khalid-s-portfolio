# Copy to `.env` and fill in. Never commit `.env`.
#
# The server validates this file at startup and refuses to boot if a required
# variable is missing, so a misconfigured deploy fails loudly instead of running
# with a weak default.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Signs administrator JWTs.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SECRET=

# Signs session cookies. Must differ from ADMIN_SECRET so compromising one does
# not compromise the other. This was previously the literal string 'secret',
# hardcoded in index.js -- rotate it, and expect existing sessions to end.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
COOKIE_SECRET=

# Comma-separated list of exact browser origins allowed to call this API.
# Example: https://khalidahammed.com,https://www.khalidahammed.com
REMOTE_CLIENT_APP=http://localhost:5173

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=8000

# Administrator session length in minutes (5-1440). The cookie lifetime tracks
# this exactly; the two used to disagree by 23 hours.
ADMIN_SESSION_MINUTES=60

# Cookie SameSite policy: lax | strict | none.
# 'lax' is correct while the site and API share a registrable domain
# (khalidahammed.com and api.khalidahammed.com are same-site). Hosting the
# client on an unrelated domain makes requests genuinely cross-site and
# requires 'none', which only works over HTTPS.
COOKIE_SAME_SITE=lax

# bcrypt cost for new administrator passwords (10-15).
SALT=12

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

DB_HOST=localhost
DB_PORT=3306
DB_NAME=khalid_portfolio
DB_USER=
DB_PASS=
