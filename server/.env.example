# Runtime
NODE_ENV=development
PORT=8000
REMOTE_CLIENT_APP=http://localhost:5173
# Startup accepts integer bytes or b/kb/mb suffixes. JSON is bounded to
# 1 KiB-1 MiB; URL-encoded bodies are bounded to 1 KiB-256 KiB.
JSON_BODY_LIMIT=256kb
URL_ENCODED_BODY_LIMIT=64kb
# Explicit Node HTTP policy. Request timeout bounds body receipt; provider and
# image-processing operations retain their own narrower deadlines. Keep the
# header timeout at or below the request timeout and mirror these limits at the
# public reverse proxy.
HTTP_REQUEST_TIMEOUT_MS=300000
HTTP_HEADERS_TIMEOUT_MS=60000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
HTTP_MAX_HEADERS_COUNT=100
HTTP_MAX_REQUESTS_PER_SOCKET=1000
SHUTDOWN_TIMEOUT_MS=10000
# Coalesces readiness probes so request bursts do not become database bursts.
READINESS_CACHE_MS=5000
# Number of explicitly trusted reverse-proxy hops. Keep 0 when directly exposed.
# Set this to the exact deployment topology; never enable blanket proxy trust.
TRUST_PROXY_HOPS=0

# In-memory limits reset on restart and are isolated per process. Put a shared
# limiter at the trusted proxy/WAF (or add a distributed store) before scaling.
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX_REQUESTS=300
ADMIN_LOGIN_RATE_LIMIT_WINDOW_MS=900000
ADMIN_LOGIN_RATE_LIMIT_MAX_REQUESTS=10
READINESS_RATE_LIMIT_WINDOW_MS=900000
READINESS_RATE_LIMIT_MAX_REQUESTS=1800

# Generate two different random values (for example: openssl rand -hex 32).
ADMIN_SECRET=
COOKIE_SECRET=

# Production may use DATABASE_URL or all DB_* connection variables below.
# Run `npm run db:migrate:production` as a release step before `npm start`;
# startup intentionally refuses an uninitialized or pending migration state.
DATABASE_URL=
DB_HOST=
DB_NAME=
DB_PASS=
DB_USER=
DB_PORT=3306
DB_POOL_MAX=20
DB_POOL_MIN=0
DB_POOL_ACQUIRE_MS=30000
DB_POOL_IDLE_MS=10000
# Development may use false for a loopback database. Production requires true
# and always verifies the server certificate.
DB_SSL=false
# Optional PEM CA; represent line breaks as \n when stored on one line.
DB_SSL_CA=

# Admin account maintenance. ADMIN_USERNAME is not a secret. Passwords are
# accepted only through the hidden prompt or standard input, never an argument
# or environment variable. Bcrypt cost may be 10-14 (12 is the default).
# After migrating: `ADMIN_USERNAME=... npm run admin:bootstrap` (first account)
# or `ADMIN_USERNAME=... npm run admin:rotate` (existing account).
ADMIN_USERNAME=
ADMIN_PASSWORD_BCRYPT_COST=12

# Absolute path to the uploaded-media root. Leave unset to keep media in
# server/uploads, which is correct for a single machine but is lost whenever a
# deploy replaces the directory. Point this at a mounted volume or attached
# disk so media survives redeploys and server moves. Database rows store
# relative paths ("uploads/projects/12/..."), so moving the bytes and setting
# this variable is all that is required; no rows change. After any move run
# `npm run media:verify` to prove every reference still resolves.
UPLOADS_DIR=

# Optional absolute path to a readable, regular PDF of at most 20 MiB. The
# server verifies the .pdf extension and %PDF- signature before exposing it;
# the client hides resume actions when the file is unavailable or invalid.
RESUME_FILE_PATH=

# Optional test-database overrides. They fall back to DB_* when omitted.
TEST_DB_HOST=
TEST_DB_NAME=
TEST_DB_PASS=
TEST_DB_USER=
TEST_DB_PORT=3306

# Outbound email/SMS providers
MAIL_HOST=
MAIL_PORT=465
MAIL_SECURE=true
MAIL_FROM_NAME=
# SMTP operations and pooled connections stay bounded. Tune only within the
# validated limits documented by startup errors.
MAIL_DELIVERY_TIMEOUT_MS=45000
MAIL_CONNECTION_TIMEOUT_MS=10000
MAIL_DNS_TIMEOUT_MS=10000
MAIL_GREETING_TIMEOUT_MS=10000
MAIL_SOCKET_TIMEOUT_MS=30000
MAIL_POOL_MAX_CONNECTIONS=3
MAIL_POOL_MAX_MESSAGES=100
MAIL_PASS=
SERVER_EMAIL=
# SMS stays disabled until this is an HTTPS endpoint confirmed to accept
# application/x-www-form-urlencoded POST bodies (never credentials in the URL).
SMS_API_URL=
SMS_MAX_CONCURRENCY=3
SMS_TIMEOUT_MS=10000
SMS_PASS=
SMS_USERNAME=
