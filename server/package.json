{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "admin:bootstrap": "node scripts/admin-account.js bootstrap",
    "admin:rotate": "node scripts/admin-account.js rotate",
    "check:syntax": "find . -path ./node_modules -prune -o -name '*.js' -type f -exec node --check {} \\;",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:production": "sequelize-cli db:migrate --env production",
    "db:migrate:status": "sequelize-cli db:migrate:status",
    "dev": "nodemon index.js",
    "start": "node index.js",
    "test": "node --test"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "http-status-codes": "^2.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "mysql2": "^3.23.1",
    "nodemailer": "^9.0.3",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
  "overrides": {
    "lodash": "^4.18.1",
    "sequelize": {
      "uuid": "^11.1.1"
    }
  }
