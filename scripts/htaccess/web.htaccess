<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Canonical scheme and host first. Below the SPA fallback these are
  # unreachable: /about-me is rewritten to /index.html with [L], mod_rewrite
  # restarts, and the second pass exits on the ^index\.html$ rule -- so only
  # direct asset requests ever reached the redirect.
  #
  # Two rules rather than one [OR] pair, so a request that is both http and
  # www still lands on the canonical URL in a single hop. X-Forwarded-Proto is
  # checked as well: terminating TLS upstream would otherwise turn the first
  # rule into a redirect loop.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^(.*)$ https://khalidahammed.com/$1 [L,R=301]

  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^(.*)$ https://khalidahammed.com/$1 [L,R=301]

  # React Router owns the URL space: anything that is not a real file is
  # answered with index.html. Route-agnostic on purpose -- a new page needs no
  # change here, ever.
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Vite fingerprints these names, so the content behind one never changes.
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # public/ keeps stable names -- a year here would make replacing an image
  # invisible to anyone who had already loaded the site.
  <FilesMatch "\.(woff2|glb|png|jpe?g|gif|svg|ico|webp)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

  # Must revalidate: a stale shell points at chunk names that no longer exist.
  <FilesMatch "\.(html|xml|txt|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json image/svg+xml
</IfModule>

AddType model/gltf-binary .glb

# The one directive here that needs AllowOverride All (cPanel's default).
# Delete this line if the site starts returning 500 after a deploy.
Options -Indexes
