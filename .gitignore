# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
build/

# deploy/ is the exception and is committed on purpose: cPanel deploys by
# copying files and its deploy shell has no Node, so the artefacts have to
# travel through git. scripts/build-deploy.sh writes it; nothing else should.
#
# Source maps stay out regardless. Turning on build.sourcemap would otherwise
# publish the entire source tree into a public directory and into this
# repository, in one commit, with nothing complaining.
deploy/**/*.map

# Environment — never commit real credentials
.env
.env.*
!.env.example

# Private working notes (audit, plans, verification evidence)
docs/

# Deployment runbook. It describes how my host is wired: which variables the
# server refuses to boot without, how to rotate them, migration order, and the
# advisories I have accepted. None of that is a secret on its own, but together
# it is a map of the production setup and there is no reason to hand it out.
DEPLOYMENT.md

# Visual-regression harness. Kept out of the repository by request: it is local
# tooling, and it carries a fixture set (a copy of production media) that has no
# business in a public repo. It still runs locally and is still the gate every
# change goes through; see the "How changes are verified" section of README.md.
verification/

test-results/
playwright-report/
blob-report/

# Runtime
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Uploaded media (server-owned, not source)
server/uploads/

# Archives and OS/editor metadata
*.zip
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local development database backups written by scripts/seed-local.js
server/local-db-backup-*.json
