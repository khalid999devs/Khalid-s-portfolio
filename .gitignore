# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
build/

# Environment — never commit real credentials
.env
.env.*
!.env.example

# Private working notes (audit, plans, verification evidence)
docs/

# Visual-regression harness artifacts
verification/output/
verification/**/*-actual.png
verification/**/*-diff.png
test-results/
playwright-report/
blob-report/

# Runtime
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Uploaded media (server-owned, not source)
server/uploads/

# Archives and OS/editor metadata
*.zip
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local development database backups written by scripts/seed-local.js
server/local-db-backup-*.json
