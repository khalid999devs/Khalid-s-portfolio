# API origin used by the browser at runtime.
# Leave empty in a production build when the API is served from the same origin
# as the site; requests then use relative paths and no CORS exchange occurs.
# Set it only when the API is intentionally hosted elsewhere.
VITE_API_URL=http://localhost:8000

# --- Build-time only. Read by scripts/generate-sitemap.mjs. Never exposed to
# --- the browser, because Vite only forwards VITE_-prefixed values.

# Public origin written into sitemap.xml entries. Must match the canonical
# origin the site is actually served from, or search engines discard the
# sitemap as cross-origin.
SITE_ORIGIN=https://khalidahammed.com

# API origin the sitemap generator reads the project catalogue from. When unset
# the build still succeeds but emits the static routes only, so project pages
# silently stop being listed. Set this in any pipeline that publishes the site.
SITEMAP_API_URL=http://localhost:8000
